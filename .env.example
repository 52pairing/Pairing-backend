# =====================================================================
# 환경변수 템플릿
#
# 사용법: 이 파일을 .env로 복사한 뒤 값을 채운다. (.env는 커밋되지 않는다)
#   cp .env.example .env
#
# Spring Boot는 .env를 자동으로 읽지 않는다. 주입 방법은 .env 상단 주석을 참고한다.
#
# 규칙 두 가지
#   1) 값에 & = / + 등이 들어가면 반드시 따옴표로 감싼다.
#      특히 JDBC URL의 '&'는 따옴표가 없으면 셸이 백그라운드 연산자로 해석해 값이 비어버린다.
#   2) 값을 정하지 않은 키는 KEY= 로 비워두지 말고 "주석 처리"한다.
#      Spring의 ${KEY:기본값}은 키가 없을 때만 기본값을 쓴다.
#      빈 문자열로 존재하면 그 빈 값을 그대로 써서 기동에 실패할 수 있다.
# =====================================================================

# ---------------------------------------------------------------------
# 필수 — 없으면 기동에 실패한다
# ---------------------------------------------------------------------

# JWT 서명 키 (HS256, 32바이트 이상). 생성: openssl rand -base64 48
JWT_SECRET_KEY=""

# S3 버킷명. 업로드를 아직 안 쓰면 임의 문자열도 가능하다.
S3_BUCKET=""

# ---------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------
DB_URL="jdbc:postgresql://localhost:5432/pairing"
DB_USERNAME=pairing
DB_PASSWORD=pairing

# ---------------------------------------------------------------------
# Redis (기본 포트 6379)
# ---------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_SSL_ENABLED=false

# ---------------------------------------------------------------------
# 선택 — 주석을 풀고 값을 넣는다
# ---------------------------------------------------------------------
# AWS_ACCESS_KEY=
# AWS_SECRET_KEY=
# AWS_REGION=ap-northeast-2
# S3_CDN_URL=
# COOKIE_DOMAIN=.example.com
# COOKIE_SECURE=false
# CORS_ALLOWED_ORIGINS=http://localhost:3000
