# =====================================================================
# 환경변수 템플릿
#
# 사용법: 이 파일을 .env로 복사한 뒤 값을 채운다. (.env는 커밋되지 않는다)
#   cp .env.example .env
#
# Spring Boot는 .env를 자동으로 읽지 않는다. 주입 방법은 .env 상단 주석을 참고한다.
#
# 규칙 두 가지
#   1) 값에 & = / + 등이 들어가면 반드시 따옴표로 감싼다.
#      특히 JDBC URL의 '&'는 따옴표가 없으면 셸이 백그라운드 연산자로 해석해 값이 비어버린다.
#   2) 값을 정하지 않은 키는 KEY= 로 비워두지 말고 "주석 처리"한다.
#      Spring의 ${KEY:기본값}은 키가 없을 때만 기본값을 쓴다.
#      빈 문자열로 존재하면 그 빈 값을 그대로 써서 기동에 실패할 수 있다.
#
# 이 파일에 실제 키·비밀번호를 적지 않는다. 값은 각자 로컬 .env나 시크릿 저장소에만 둔다.
#
# 로컬에서 인프라 없이 띄우려면 local 프로파일을 쓴다. (H2 + 더미 키, 아래 값 대부분 불필요)
#   ./gradlew bootRun --args='--spring.profiles.active=local'
# =====================================================================


# =====================================================================
# 1. 필수 — 없으면 기동에 실패한다 (RequiredPropertyFailureAnalyzer가 원인을 알려준다)
# =====================================================================

# JWT 서명 키 (HS256, 32바이트 이상)
#   생성: openssl rand -base64 48
JWT_SECRET_KEY=""

# 카드번호·계좌번호 AES-256-GCM 암호화 키 (Base64, 정확히 32바이트)
#   생성: openssl rand -base64 32
#   주의: 이 키를 바꾸면 기존에 저장된 암호문을 복호화할 수 없다. 교체 시 재암호화가 필요하다.
DATA_ENCRYPTION_KEY=""

# S3 버킷명. 파일 업로드를 아직 안 쓰면 임의 문자열(local-dev-placeholder)도 된다.
S3_BUCKET=""


# =====================================================================
# 2. PostgreSQL
# =====================================================================
DB_URL="jdbc:postgresql://localhost:5432/pairing"
DB_USERNAME=pairing
DB_PASSWORD=pairing


# =====================================================================
# 3. Redis
#    리프레시 토큰, 단일 세션, 이메일 발송 제한, IP 차단, 비밀번호 재설정 토큰,
#    소셜 가입 티켓을 저장한다. 없으면 로그인·가입이 동작하지 않는다.
# =====================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
# 전송 중 암호화를 쓰는 관리형 Redis면 true
REDIS_SSL_ENABLED=false


# =====================================================================
# 4. 메일 (이메일 인증코드 / 비밀번호 재설정 링크 / 임시 비밀번호)
#
#    미설정이어도 서버는 뜬다. 발송 시점에만 AU_026으로 실패한다.
#    (메일 헬스체크는 꺼져 있어 /actuator/health는 UP을 유지한다)
#
#    Gmail: 2단계 인증 후 "앱 비밀번호"(16자리)를 MAIL_PASSWORD에 넣는다. 계정 비밀번호로는 실패한다.
#    네이버: 메일 환경설정에서 SMTP 사용을 켜고, 2단계 인증 중이면 앱 비밀번호를 쓴다.
# =====================================================================
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=발송계정@gmail.com
# MAIL_PASSWORD=""
# 발신자 표시 주소. MAIL_USERNAME과 다르면 메일 서버가 거부할 수 있다.
# MAIL_FROM=발송계정@gmail.com
#
# 587(STARTTLS) 기본값이라 보통 건드릴 필요가 없다.
# 465(SSL)를 쓰려면 application.yaml에 mail.smtp.ssl.enable 설정을 추가해야 한다.
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true


# =====================================================================
# 5. 프론트엔드 연동 (CORS / 쿠키 / 링크)
#
#    토큰을 HttpOnly 쿠키로 내려주므로, 프론트 오리진이 여기 없으면 로그인 자체가 안 된다.
#    credentials를 쓰기 때문에 와일드카드 *는 사용할 수 없다.
# =====================================================================
# 허용 오리진 목록(쉼표 구분). 기본값: http://localhost:17000,http://127.0.0.1:17000
# CORS_ALLOWED_ORIGINS=http://localhost:17000

# 비밀번호 재설정 메일 링크를 조립할 프론트 주소. 기본값: http://localhost:17000
#   실제 링크: {APP_FRONT_BASE_URL}/reset-password?token=...
# APP_FRONT_BASE_URL=http://localhost:17000

# 쿠키 도메인. 비워두면 host-only 쿠키라 localhost에서도 저장된다.
# COOKIE_DOMAIN=.example.com

# https 배포에서만 true. true일 때만 SameSite=None(크로스 도메인 전송)이 유효하다.
# COOKIE_SECURE=false


# =====================================================================
# 6. 소셜 로그인 (프리랜서 전용)
#
#    미설정이어도 서버는 뜬다. 소셜 인가/콜백 호출 시점에만 AU_018로 실패한다.
#    redirect-uri는 공급자 콘솔에 등록한 값과 정확히 같아야 하며, 콜백을 받는 쪽은 프론트다.
# =====================================================================
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
# KAKAO_REDIRECT_URI=http://localhost:17000/oauth/callback/kakao

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:17000/oauth/callback/google


# =====================================================================
# 7. 선택 — 기본값으로 두어도 되는 것들
# =====================================================================
# AWS 리전. 기본값: ap-northeast-2
# AWS_REGION=ap-northeast-2

# 응답 URL 루트(CloudFront). 비우면 버킷·리전으로 자동 조합한다.
# S3_CDN_URL=

# 액세스 키는 비워두는 것을 권장한다. (비우면 AWS 기본 자격증명 체인 → 배포는 IAM 역할 사용)
# AWS_ACCESS_KEY=
# AWS_SECRET_KEY=

# STOMP 핸드셰이크 경로. 바꾸면 GlobalSecurityConfig의 permitAll 경로도 함께 맞춰야 한다.
# WEBSOCKET_ENDPOINT=/ws


# =====================================================================
# 8. 환경변수가 아닌 것
#
#    인증 기준값(코드 유효 3분, 발송 15회/1시간, 로그인 5회 잠금, IP 20회→2시간 차단,
#    가입 티켓 30분, 최소 연령 18세 등)은 application.yaml의 app.auth.* 에 있다.
#    운영에서 조정할 일이 생기면 그쪽을 바꾼다.
# =====================================================================
